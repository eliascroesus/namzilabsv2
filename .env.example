# --- Database (Neon Postgres) ---
# On the default HTTP driver: the POOLED host ("-pooler") is fine and is what
# Neon recommends for serverless.
#
# ⚠ THE MOMENT ANY DB_DRIVER* FLAG BELOW IS SET TO "pool", THIS MUST BE THE
# DIRECT (non "-pooler") HOST. Neon's pooler is transaction-mode PgBouncer: it
# does not hold a session across statements, which silently breaks the
# advisory locks and multi-statement transactions the pool driver exists to
# enable. See PRE_LAUNCH_CHECKLIST.md item 4 for the rollout order and the
# max_connections arithmetic that goes with the direct host.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT (non-pooled) connection string, used only for running migrations (DDL).
# Same Neon database, without the "-pooler" host. Falls back to DATABASE_URL if unset.
DATABASE_MIGRATION_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# Staged driver migration (plan B.3). "http" = stateless Neon HTTP driver
# (default, instant rollback). "pool" = WebSocket Pool driver: real sessions,
# db.transaction(), advisory locks. Rollout: set DB_DRIVER_READ=pool first and
# soak the read-only surfaces in production, THEN move the writer with
# DB_DRIVER=pool. DB_DRIVER_READ falls back to DB_DRIVER when unset.
# DB_DRIVER="http"
# DB_DRIVER_READ="pool"
# Sockets per container when the pool driver is active. Clamped UP to the
# code-derived floor (7 — see MIN_POOL_MAX in src/db/client.ts); a smaller
# pool deadlocks rather than degrades. The lever for staying under Neon's
# connection ceiling is container count, not pool size.
# DB_POOL_MAX="7"

# --- Rollout flags ---
# Custom-webhook event time. Unset (the default) means the nightly scan works out
# which payload key holds each webhook connection's event time and RECORDS the
# answer, while events keep being dated exactly as before. "1" makes it live:
# new events use the resolved key, and the first nightly run restamps every
# catch-hook connection's stored events. Both halves flip together on purpose.
# Look before flipping — paste scripts/webhook-event-time.sql into the Neon
# editor to see what each connection would pick. See STATE.md.
# WEBHOOK_EVENT_TIME_LIVE="1"

# Storage retention. Unset (the default) means the nightly prune-storage job
# runs in INSPECT mode: it reports what it WOULD delete, split by table and
# tier, and deletes nothing. "1" makes the deletes live. Flip only after
# reading one night's [storage-prune-inspect] log line — the procedure and the
# PASS criteria are PRE_LAUNCH_CHECKLIST.md item 7b. Rollback: unset it.
# STORAGE_PRUNE_LIVE="1"

# Compiled query engine (filter pushdown into SQL) — parity-proven, default
# off. Rollout order (checklist item 8): TEST flag first (node Tests only —
# the soak seam), full flag after. Either reverts instantly by unsetting.
# ENGINE_COMPILE_TEST="1"
# ENGINE_COMPILE="1"

# --- Ops ---
# Shared secret that unlocks /api/health's full diagnostic body (env-var
# presence by name, database error detail). Anonymous callers always get the
# bare {status} with a meaningful HTTP code, so an uptime monitor works
# without it; give the monitor this value in an `x-health-token` header to
# see WHY. Unset = nobody gets detail (fails closed).
# Generate: `openssl rand -hex 24`
# HEALTH_CHECK_TOKEN=""

# Per-org creation caps — a blast-radius bound against runaway scripts, not
# billing (invite-only launch; see src/lib/limits.ts). Optional overrides:
# MAX_CONNECTIONS_PER_ORG="10"
# MAX_FLOWS_PER_ORG="25"

# Ops alert emails (src/lib/alerts.ts): the nightly invariant scan and a
# truncated storage prune email their findings instead of dying in a log
# line. All three must be set or nothing sends (dev/CI stay silent).
# ALERT_FROM must be a sender verified in your Resend account.
# RESEND_API_KEY=""
# ALERT_EMAIL="you@yourdomain.com"
# ALERT_FROM="alerts@yourdomain.com"

# --- Encryption ---
# 32-byte key for AES-256-GCM encryption of stored OAuth tokens / API keys / signing secrets.
# Generate: `openssl rand -base64 32`  (base64) or `openssl rand -hex 32` (hex)
ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64_OR_HEX_KEY"

# --- Inngest (durable execution / queue / cron) ---
# From the Inngest dashboard. Not required for local `inngest-cli dev`.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- WorkOS AuthKit (auth + organizations) ---
# From the WorkOS dashboard (https://dashboard.workos.com).
WORKOS_API_KEY="sk_test_..."
WORKOS_CLIENT_ID="client_..."
# Session cookie password, 32+ characters. Generate: `openssl rand -base64 24`
WORKOS_COOKIE_PASSWORD="REPLACE_WITH_32_PLUS_CHAR_SECRET"
# Must exactly match a redirect URI configured in the WorkOS dashboard.
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/callback"

# --- Google OAuth (Sheets + Calendar connectors) ---
# From Google Cloud Console (OAuth client for namzilabs). The redirect URI must
# be registered there and default to `${APP_BASE_URL}/api/oauth/google/callback`.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override; defaults to `${APP_BASE_URL}/api/oauth/google/callback`.
GOOGLE_REDIRECT_URI=""

# --- App ---
# Public base URL of this deployment. Used for post-sign-out redirect, building
# inbound webhook URLs, and the Google OAuth redirect.
APP_BASE_URL="https://app.namzilabs.com"
